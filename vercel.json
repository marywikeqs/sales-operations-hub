{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/portal",
      "destination": "/api/portal"
    },
    {
      "source": "/portal/:path*",
      "destination": "/api/portal"
    },
    {
      "source": "/commissions",
      "destination": "/api/portal"
    },
    {
      "source": "/commissions/:path*",
      "destination": "/api/portal"
    }
  ],
  "functions": {
    "api/portal.py": {
      "maxDuration": 10
    }
  }
}
